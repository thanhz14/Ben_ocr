        {
            "block_label": "paragraph_title",
            "block_content": "### I. Introduction",
            "block_bbox": [
                280,
                1120,
                417,
                1141
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
