        {
            "block_label": "paragraph_title",
            "block_content": "### II. Problem Formulation",
            "block_bbox": [
                762,
                757,
                987,
                781
            ],
            "block_id": 13,
            "block_order": 9,
            "group_id": 13,
            "block_polygon_points": [
