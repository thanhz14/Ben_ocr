        {
            "block_label": "table",
            "block_content": "\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td style='text-align: center; word-wrap: break-word;'>Method</td><td style='text-align: center; word-wrap: break-word;'>Modeling level</td><td style='text-align: center; word-wrap: break-word;'>Updated variable</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>LaPnP [17]</td><td style='text-align: center; word-wrap: break-word;'>RM level</td><td style='text-align: center; word-wrap: break-word;'>Reconstructed RM estimate</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>RadioDiff-Inverse [18]</td><td style='text-align: center; word-wrap: break-word;'>RM level</td><td style='text-align: center; word-wrap: break-word;'>Posterior RM samples</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>RadioTrace</td><td style='text-align: center; word-wrap: break-word;'>Tx-condition level</td><td style='text-align: center; word-wrap: break-word;'>Tx locations + RM</td></tr></table>",
