        {
            "block_label": "paragraph_title",
            "block_content": "### K. Scalability",
            "block_bbox": [
                620,
                1006,
                750,
                1031
            ],
            "block_id": 14,
            "block_order": 8,
            "group_id": 14,
            "block_polygon_points": [
                [
                    620.0,
