        {
            "block_label": "table",
            "block_content": "\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td style='text-align: center; word-wrap: break-word;'>T</td><td style='text-align: center; word-wrap: break-word;'>NMSE</td><td style='text-align: center; word-wrap: break-word;'>RMSE</td><td style='text-align: center; word-wrap: break-word;'>SSIM  $ \\uparrow $</td><td style='text-align: center; word-wrap: break-word;'>PSNR  $ \\uparrow $</td><td style='text-align: center; word-wrap: break-word;'>rate (maps/s)</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>100</td><td style='text-align: center; word-wrap: break-word;'>0.0174</td><td style='text-align: center; word-wrap: break-word;'>0.0296</td><td style='text-align: center; word-wrap: break-word;'>0.9518</td><td style='text-align: center; word-wrap: break-word;'>31.95</td><td style='text-align: center; word-wrap: break-word;'>0.0618</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>50</td><td style='text-align: center; word-wrap: break-word;'>0.0186</td><td style='text-align: center; word-wrap: break-word;'>0.0306</td><td style='text-align: center; word-wrap: break-word;'>0.9497</td><td style='text-align: center; word-wrap: break-word;'>31.70</td><td style='text-align: center; word-wrap: break-word;'>0.1187</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>10</td><td style='text-align: center; word-wrap: break-word;'>0.0222</td><td style='text-align: center; word-wrap: break-word;'>0.0327</td><td style='text-align: center; word-wrap: break-word;'>0.9468</td><td style='text-align: center; word-wrap: break-word;'>31.28</td><td style='text-align: center; word-wrap: break-word;'>0.5832</td></tr></table>",
