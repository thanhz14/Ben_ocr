                    620.0,
                    1031.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We evaluate scalability with respect to the number of Tx by varying  $ R \\in \\{1, 2, 3, 4, 5\\} $ with 1% sampling rate, while keeping the environment, map resolution, and measurement protocol fixed. As shown in Fig. 11, as the number of Tx increases, the RMSE gradually rises while the PSNR consistently decreases, indicating that the reconstruction task becomes more challenging in more complex multi-Tx scenarios. Nevertheless, the overall degradation remains moderate, which demonstrates that the proposed method still maintains reasonable scalability.",
            "block_bbox": [
                617,
                1042,
                1131,
                1281
            ],
            "block_id": 15,
            "block_order": 9,
            "group_id": 15,
            "block_polygon_points": [
                [
                    617.0,
