        {
            "block_label": "paragraph_title",
            "block_content": "### I. Extreme low sampling rate performance",
            "block_bbox": [
                93,
                929,
                478,
                952
            ],
            "block_id": 6,
            "block_order": 2,
            "group_id": 6,
            "block_polygon_points": [
