        {
            "block_label": "paragraph_title",
            "block_content": "### D. Results of comparable experiments",
            "block_bbox": [
                93,
                750,
                439,
                774
            ],
            "block_id": 3,
            "block_order": 1,
            "group_id": 3,
            "block_polygon_points": [
                [
