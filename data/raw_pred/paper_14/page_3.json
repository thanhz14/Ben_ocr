                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Definition 3 (Tightness). For a cell set $\\mathcal{S} \\subseteq \\mathbb{R}^d$ in model $\\theta's$ embedding, with centroid $\\mu_S = |\\mathcal{S}|^{-1} \\sum_{c \\in \\mathcal{S}} c$, the tightness is the mean cosine to the centroid:",
            "block_bbox": [
                125,
                306,
                1062,
                362
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    125.0,
                    306.0
                ],
                [
                    1062.0,
                    306.0
                ],
                [
                    1062.0,
                    362.0
                ],
                [
                    125.0,
                    362.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T_{\\theta}(\\mathcal{S})=\\frac{1}{|\\mathcal{S}|}\\sum_{c\\in\\mathcal{S}}\\frac{\\langle c,\\mu_{\\mathcal{S}}\\rangle}{\\|c\\|\\|\\mu_{\\mathcal{S}}\\|}. $$ ",
            "block_bbox": [
                466,
                382,
                721,
                442
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
