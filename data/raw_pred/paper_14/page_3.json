        {
            "block_label": "paragraph_title",
            "block_content": "### 3.3 Embedding tightness and donor-matched gap",
            "block_bbox": [
                124,
                255,
                729,
                284
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
