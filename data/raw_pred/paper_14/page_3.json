    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "For a target set with ground-truth membership labels  $ \\{(c_j, y_j)\\}_{j=1}^N (y_j \\in \\{\\text{in, out}\\}) $, the MIA-scFM AUROC is computed against  $ -\\bar{\\ell}_\\theta(c) $ as the score. The convention is that members (held-in) should have lower loss than non-members (held-out).",
            "block_bbox": [
                124,
                130,
                1064,
                217
            ],
            "block_id": 0,
