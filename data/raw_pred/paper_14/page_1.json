        {
            "block_label": "paragraph_title",
            "block_content": "## 2 Related Work",
            "block_bbox": [
                126,
                621,
                374,
                651
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
