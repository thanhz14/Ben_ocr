                [
                    126.0,
                    694.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• AIDA v2 (Kock et al., 2025): the Asian Immune Diversity Atlas, a post-cutoff multi-ancestry healthy PBMC reference. n = 50,000 subsampled.",
            "block_bbox": [
                126,
                696,
                1063,
