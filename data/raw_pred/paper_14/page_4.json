                [
                    1065.0,
                    585.0
                ],
                [
                    126.0,
                    585.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Human pancreatic islet: a combined version of two CELLxGENE Census collections (37b21763, 3294d050), filtered to canonical islet cell types and stratified-subsampled to a maximum of 1,500 cells per type. n = 11,583 cells, 10 expert-annotated cell types, 29 donors. The underlying single-cell deposits predate Genecorpus-30M's mid-2021 cutoff.",
            "block_bbox": [
                126,
                588,
                1071,
                694
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    126.0,
