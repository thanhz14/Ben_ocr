                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• PBMC 3k (Zheng et al., 2017): a canonical immune-cell integration benchmark from 10x Genomics, originally released in 2017 and re-used in dozens of subsequent benchmarks. n = 2,700 cells.",
            "block_bbox": [
                126,
                506,
                1065,
                585
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
