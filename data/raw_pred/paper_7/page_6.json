        },
        {
            "block_label": "text",
            "block_content": "Example 2.1. Find a canonical set of pole cancellation functions at the pole  $ \\beta = 1 $ of the matrix-valued function",
            "block_bbox": [
                232,
                469,
                955,
                522
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
                [
                    232.0,
