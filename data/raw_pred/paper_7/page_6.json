            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ Q(z)=\\left(\\begin{array}{c c c}{\\frac{1}{(z-1)^{2}}}&{1}&{z+1}\\\\ {1}&{z^{2}}&{z}\\\\ {z+1}&{z}&{\\frac{1}{z-1}}\\\\ \\end{array}\\right). $$ ",
            "block_bbox": [
