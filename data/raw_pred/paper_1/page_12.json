            "block_label": "table",
            "block_content": "\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td rowspan=\"3\">Method</td><td colspan=\"2\">BERT-base</td><td colspan=\"2\">OPT-125M</td></tr><tr><td colspan=\"2\">88.53 F1  $ \\uparrow $</td><td colspan=\"2\">27.66 PPL  $ \\downarrow $</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>4bit</td><td style='text-align: center; word-wrap: break-word;'>3bit</td><td style='text-align: center; word-wrap: break-word;'>4bit</td><td style='text-align: center; word-wrap: break-word;'>3bit</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>OBQ</td><td style='text-align: center; word-wrap: break-word;'>88.23</td><td style='text-align: center; word-wrap: break-word;'>85.29</td><td style='text-align: center; word-wrap: break-word;'>32.52</td><td style='text-align: center; word-wrap: break-word;'>69.32</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>GPTQ</td><td style='text-align: center; word-wrap: break-word;'>88.18</td><td style='text-align: center; word-wrap: break-word;'>86.02</td><td style='text-align: center; word-wrap: break-word;'>31.12</td><td style='text-align: center; word-wrap: break-word;'>53.85</td></tr></table>",
