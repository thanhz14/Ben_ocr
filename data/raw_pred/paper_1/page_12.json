                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This section provides additional details about our experiment setup, in particular regarding the model evaluation and the setup of our timing experiments.",
            "block_bbox": [
                209,
                584,
                1010,
                629
            ],
            "block_id": 7,
            "block_order": 5,
            "group_id": 7,
            "block_polygon_points": [
