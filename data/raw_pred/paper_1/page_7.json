            "block_label": "table",
            "block_content": "\n<table border=1 style='margin: auto; word-wrap: break-word;'><tr><td style='text-align: center; word-wrap: break-word;'>GPU</td><td style='text-align: center; word-wrap: break-word;'>FP16</td><td style='text-align: center; word-wrap: break-word;'>3bit</td><td style='text-align: center; word-wrap: break-word;'>Speedup</td><td style='text-align: center; word-wrap: break-word;'>GPU reduction</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>A6000-48GB</td><td style='text-align: center; word-wrap: break-word;'>589ms</td><td style='text-align: center; word-wrap: break-word;'>130ms</td><td style='text-align: center; word-wrap: break-word;'>4.53 $ \\times $</td><td style='text-align: center; word-wrap: break-word;'>8 $ \\rightarrow $2</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>A100-80GB</td><td style='text-align: center; word-wrap: break-word;'>230ms</td><td style='text-align: center; word-wrap: break-word;'>71ms</td><td style='text-align: center; word-wrap: break-word;'>3.24 $ \\times $</td><td style='text-align: center; word-wrap: break-word;'>5 $ \\rightarrow $1</td></tr></table>",
