                    1011.0,
                    1114.0
                ],
                [
                    210.0,
                    1114.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Full Algorithm. Finally, we present the full pseudocode for GPTQ in Algorithm 1, including the optimizations discussed above.",
            "block_bbox": [
                211,
                1121,
                1012,
                1168
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
