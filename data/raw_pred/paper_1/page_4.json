                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\begin{array}{r}{\\delta_{F}=-(\\mathbf{w}_{Q}-\\mathrm{q u a n t}(\\mathbf{w}_{Q}))([\\mathbf{H}_{F}^{-1}]_{Q Q})^{-1}(\\mathbf{H}_{F}^{-1})_{:,Q},}\\end{array} $$ ",
