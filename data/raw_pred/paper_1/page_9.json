        {
            "block_label": "paragraph_title",
            "block_content": "## 7 Ethics Statement",
            "block_bbox": [
                213,
                399,
                462,
                422
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
