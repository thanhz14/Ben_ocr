                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The HERA results motivate the following minimum QA procedure for any single-epoch low-rank cleaning configuration:\n\n1. Mixed-mode check: inspect the spectral structure of the leading singular vectors to determine whether protected science features plausibly contaminate the modes slated for subtraction.",
            "block_bbox": [
                94,
                1366,
                604,
                1440
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
