                    646.0,
                    370.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Proxy calibration: calibrate chosen proxy metrics against bias/failure diagnostics on a validation subset; then monitor the proxies as low-cost QA signals in large-scale processing.",
            "block_bbox": [
                646,
                384,
                1128,
                484
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
