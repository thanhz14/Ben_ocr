        {
            "block_label": "paragraph_title",
            "block_content": "#### 6.2. Evidence for mixed modes",
            "block_bbox": [
                210,
                986,
                492,
                1008
            ],
            "block_id": 6,
            "block_order": 2,
            "group_id": 6,
            "block_polygon_points": [
