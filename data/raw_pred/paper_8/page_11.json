    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Thus the fraction of time spent in  $ U_{\\varepsilon}(H) $ does not exceed  $ 3\\gamma/8 $. This contradicts the assumption (15). Consequently, the fraction of time in  $ U_{\\varepsilon}(H) $ tends to zero as  $ \\varepsilon \\to 0 $, i.e., (5) is proved.",
            "block_bbox": [
                137,
                147,
                1081,
                200
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    137.0,
                    147.0
                ],
                [
                    1081.0,
                    147.0
                ],
                [
                    1081.0,
                    200.0
                ],
                [
                    137.0,
                    200.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "It remains to deduce affine IPE. If the scalar estimate (2) does not hold, then there exist  $ T_j \\to \\infty $ and normalized pairs  $ (a_j, b_j) $,  $ \\|a_j\\|^2 + b_j^2 = 1 $, such that",
            "block_bbox": [
                138,
                201,
                1083,
                255
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    138.0,
                    201.0
                ],
                [
                    1083.0,
                    201.0
                ],
                [
                    1083.0,
                    255.0
                ],
                [
                    138.0,
                    255.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\frac{1}{T_{j}}\\int_{0}^{T_{j}}\\left|a_{j}\\cdot\\Phi^{t}(x)+b_{j}\\right|^{2}d t\\rightarrow0. $$ ",
            "block_bbox": [
                456,
                275,
                765,
                337
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
