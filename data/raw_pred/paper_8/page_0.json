        {
            "block_label": "paragraph_title",
            "block_content": "## Abstract",
            "block_bbox": [
                565,
                439,
                659,
                461
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
