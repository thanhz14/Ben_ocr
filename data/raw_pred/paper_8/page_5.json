        {
            "block_label": "display_formula",
            "block_content": " $$ u^{\\top}\\phi_{z}(t)\\phi_{z}(t)^{\\top}u=(u^{\\top}\\phi_{z}(t))^{2}=|a\\cdot z(t)+b|^{2}. $$ ",
            "block_bbox": [
                388,
                333,
