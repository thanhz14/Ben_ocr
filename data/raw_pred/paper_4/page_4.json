            ]
        },
        {
            "block_label": "text",
            "block_content": "The proposal in this paper is related to, but distinct from, several strands of the difference-in-differences literature.",
            "block_bbox": [
                137,
                1246,
                1085,
                1300
            ],
            "block_id": 16,
            "block_order": 17,
            "group_id": 16,
