                [
                    821.0,
                    791.0
                ],
                [
                    399.0,
                    791.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "be constant over time. This constant may be nonzero, so group 2 may systematically exhibit faster or slower untreated growth than group 1. Thus, our procedure allows stable violations of parallel trends. As discussed earlier, even stability of the full distribution of this prediction error is stronger than necessary for the test considered in this paper. Because the test uses only the absolute conformity scores, it is sufficient that",
            "block_bbox": [
                136,
                812,
                1087,
                947
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    136.0,
                    812.0
                ],
