        },
        {
            "block_label": "text",
            "block_content": "Overall, the distinction is between two counterfactual predictors within the same framework. Chernozhukov, Wüthrich, and Zhu's DID predictor is based on outcome levels and implies parallel trends, whereas ours is based on outcome changes and requires only distributional stability of the absolute prediction errors, or, equivalently, of the absolute untreated differential trends.",
            "block_bbox": [
                136,
                1066,
                1086,
                1175
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
            "block_polygon_points": [
