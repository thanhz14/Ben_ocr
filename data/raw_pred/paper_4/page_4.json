                    136.0,
                    1175.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 4.2 Related difference-in-differences literature",
            "block_bbox": [
                138,
                1203,
                705,
                1230
            ],
            "block_id": 15,
            "block_order": 16,
