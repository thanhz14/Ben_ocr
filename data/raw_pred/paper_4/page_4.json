                    1087.0,
                    812.0
                ],
                [
                    1087.0,
                    947.0
                ],
                [
                    136.0,
                    947.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\left|Y_{2,t}(0)-\\widehat{Y}_{2,t}(0)\\right|=\\left|Y_{2,t}(0)-Y_{2,t-1}(0)-(Y_{1,t}(0)-Y_{1,t-1}(0))\\right| $$ ",
            "block_bbox": [
                312,
                967,
                910,
                1005
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
