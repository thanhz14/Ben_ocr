    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Under $H_{0}$, the empirical distribution function in the preceding display is exactly $\\widehat{F}(u;x)$, establishing (3).",
            "block_bbox": [
                136,
                145,
                1083,
                199
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
