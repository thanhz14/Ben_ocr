                    1079.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Let  $ U_{1}, \\ldots, U_{T} $ satisfy",
            "block_bbox": [
                137,
                1101,
                356,
                1127
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
