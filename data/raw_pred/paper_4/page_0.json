                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\begin{aligned}U_{t}=U_{t}(0),\\qquad&t=1,\\ldots,T-1,\\\\&U_{T}=U_{T}(0)+\\tau,\\end{aligned} $$ ",
