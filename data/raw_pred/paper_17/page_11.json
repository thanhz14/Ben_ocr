                    976.0,
                    1024.0
                ],
                [
                    114.0,
                    1024.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "where Work Domain, Money Domain, Knowledge Domain, Power Domain and Health Domain are the output nodes of the corresponding BN instances serving to propagate the domain scores to the GEI node at the top level.",
            "block_bbox": [
                94,
                1044,
                995,
                1110
            ],
            "block_id": 9,
            "block_order": 7,
            "group_id": 9,
            "block_polygon_points": [
