                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "#### 2.1. Gender Statistics in Brief: Origins and Evolution",
            "block_bbox": [
                95,
                1172,
                734,
                1201
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
