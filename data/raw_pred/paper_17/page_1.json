                    95.0,
                    1201.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The emergence of gender statistics can be traced through five milestones that illustrate how international agendas have progressively incorporated gender-sensitive data into official monitoring frameworks:",
            "block_bbox": [
                95,
                1213,
                994,
                1259
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    95.0,
