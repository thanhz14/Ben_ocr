        {
            "block_label": "paragraph_title",
            "block_content": "## Step 1: Conceptual framework",
            "block_bbox": [
                92,
                1097,
                338,
                1118
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "block_polygon_points": [
                [
