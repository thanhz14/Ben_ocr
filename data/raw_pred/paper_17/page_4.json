                [
                    91.99998474121094,
                    1116.9998779296875
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The GEI is based on a conceptual framework composed of six domains: Work, Money, Knowledge, Time, Power, and Health, reflecting the multifaceted and latent nature of gender equality in the EU. Each domain is further detailed into 2 or 3 sub-domains, for a total of 14 sub-domains.",
            "block_bbox": [
