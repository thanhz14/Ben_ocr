        },
        {
            "block_label": "text",
            "block_content": "Women (1976–1985) promoted dedicated programmes on gender statistics, launched for instance by the UN Statistical Division (United Nations Department of Economic and Social Affairs, n.d.).",
            "block_bbox": [
                119,
                105,
                988,
                149
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
