        },
        {
            "block_label": "paragraph_title",
            "block_content": "#### 2.2. Gender Composite Indicators",
            "block_bbox": [
                91,
                1118,
                499,
                1146
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    91.0,
