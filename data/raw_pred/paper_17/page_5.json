                [
                    97.0,
                    305.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The simple indicators produced in the previous step are normalized and re-scaled to calculate a variable-specific gender equality metric ranging from 1 (no gender equality) to 100 (perfect gender equality), defined as:",
            "block_bbox": [
                96,
                309,
                994,
                356
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    96.0,
                    309.0
                ],
                [
                    994.0,
                    309.0
                ],
                [
                    994.0,
                    356.0
                ],
                [
                    96.0,
                    356.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\Gamma_{X_{i t}}=1+\\left[\\propto_{(X_{i t})}\\cdot(1-\\gamma_{X_{i t}})\\right]\\cdot99 $$ ",
            "block_bbox": [
                398,
