                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "## Step 3: Data processing",
            "block_bbox": [
                97,
                284,
                294,
                306
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    97.0,
