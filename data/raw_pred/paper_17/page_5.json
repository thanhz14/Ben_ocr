        {
            "block_label": "paragraph_title",
            "block_content": "## Step 4: Within-domain aggregation",
            "block_bbox": [
                96,
                466,
                380,
                488
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
