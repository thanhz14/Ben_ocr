                ],
                [
                    95.0,
                    1130.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Through a case study based on Italian official statistics, the paper illustrates several advantages offered by the OOBN framework when applied to the GEI. In particular:",
            "block_bbox": [
                96,
                1132,
                994,
                1178
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
