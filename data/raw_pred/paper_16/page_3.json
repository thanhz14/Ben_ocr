            ]
        },
        {
            "block_label": "formula_number",
            "block_content": "(1)",
            "block_bbox": [
                1049,
                476,
                1079,
                505
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
