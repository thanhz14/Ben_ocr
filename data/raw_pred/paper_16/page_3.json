            ]
        },
        {
            "block_label": "text",
            "block_content": "Consider $n$ rows of two blocks of variables, a predictor block $\\mathbf{X} \\in \\mathbb{R}^{n \\times p}$ and a response block $\\mathbf{Y} \\in \\mathbb{R}^{n \\times q}$, with $\\mathbf{x}_i$ and $\\mathbf{y}_i$ the $i$th rows; both blocks are centred and scaled before the decomposition. The twoblock estimator (Cook et al., 2023) performs a simultaneous sufficient dimension reduction of the two blocks: it seeks score matrices $\\mathbf{T} = \\mathbf{X}\\mathbf{W}$ and $\\mathbf{U} = \\mathbf{Y}\\mathbf{V}$, of possibly different ranks $h$ and $g$, such that",
            "block_bbox": [
                135,
                308,
                1084,
                454
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    135.0,
                    308.0
                ],
                [
                    1084.0,
                    308.0
                ],
                [
                    1084.0,
                    454.0
                ],
                [
                    135.0,
                    454.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\mathbf{Y}\\perp\\mathbf{X}\\mid\\mathbf{T}\\qquad\\mathrm{a n d}\\qquad\\mathbf{X}\\perp\\mathbf{Y}\\mid\\mathbf{U}, $$ ",
            "block_bbox": [
                410,
                474,
                810,
                505
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
