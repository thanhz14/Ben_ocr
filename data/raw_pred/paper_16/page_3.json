        {
            "block_label": "paragraph_title",
            "block_content": "## 2 The twoblock estimator",
            "block_bbox": [
                137,
                250,
                589,
                284
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
