        {
            "block_label": "paragraph_title",
            "block_content": "### 7.1 UCI energy-efficiency benchmark",
            "block_bbox": [
                139,
                203,
                680,
                235
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
