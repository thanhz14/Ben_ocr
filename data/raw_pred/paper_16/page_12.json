d;'>0.45 / 0.97</td><td style='text-align: center; word-wrap: break-word;'>0.60 / 0.89</td></tr><tr><td style='text-align: center; word-wrap: break-word;'>B</td><td style='text-align: center; word-wrap: break-word;'>0.30</td><td style='text-align: center; word-wrap: break-word;'>0.44 / 0.91</td><td style='text-align: center; word-wrap: break-word;'>0.64 / 0.82</td></tr></table>",
