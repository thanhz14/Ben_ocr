        {
            "block_label": "paragraph_title",
            "block_content": "### 7.2 Gas-turbine emissions: prediction under regime drift",
            "block_bbox": [
                137,
                925,
                949,
                956
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
