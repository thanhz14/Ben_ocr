    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "whereas the coskewness objective sees a strong signal on $z$. Here $z$ is drawn antithetically ($z$ paired with $-z$) so that every odd sample moment of $z$ vanishes exactly and the finite-sample covariance $\\widehat{\\operatorname{cov}}(z,z^2-1)$ is 0 by construction, leaving the decoy as the only linear signal; $n=1000$.",
            "block_bbox": [
                136,
                147,
                1083,
                260
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
