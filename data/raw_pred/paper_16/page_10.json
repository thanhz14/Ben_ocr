                    136.0,
                    725.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 5.3 Cross-validation termination gate",
            "block_bbox": [
                139,
                760,
                683,
                792
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
