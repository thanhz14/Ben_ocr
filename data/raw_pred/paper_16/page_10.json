                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The greedy rule above accepts any algorithmically valid split, which on small or noisy nodes can encourage growth that does not generalize. A cross-validation gate that refuses such splits is added. For a node with rows N, the node's CV score under a candidate parameter tuple is the K-fold mean of per-response variance-normalized mean squared errors, summed across responses,",
            "block_bbox": [
                136,
                808,
                1084,
                951
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
                    808.0
                ],
                [
                    1084.0,
                    808.0
                ],
                [
                    1084.0,
                    951.0
                ],
                [
                    136.0,
                    951.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ S(\\mathcal{N};\\pmb{\\sigma}^{2})=\\frac{1}{K}\\sum_{k=1}^{K}\\sum_{j=1}^{q}\\frac{\\frac{1}{|V_{k}|}\\sum_{i\\in V_{k}}(y_{i j}-\\hat{y}_{i j})^{2}}{\\sigma_{j}^{2}}. $$ ",
            "block_bbox": [
                381,
                949,
                838,
                1026
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
