                ],
                [
                    319.0,
                    1082.0
                ]
            ]
        },
        {
            "block_label": "formula_number",
            "block_content": "(9)",
            "block_bbox": [
                1050,
                1051,
                1079,
                1080
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
