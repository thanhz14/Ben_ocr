                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\max_{\\|\\boldsymbol{w}\\|=\\|\\boldsymbol{v}\\|=1}\\left(1-\\gamma\\right)\\mathbb{E}[t\\boldsymbol{u}]+\\gamma\\mathbb{E}[t^{2}\\boldsymbol{u}],\\qquad\\gamma\\in[0,1], $$ ",
