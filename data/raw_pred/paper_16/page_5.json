        {
            "block_label": "paragraph_title",
            "block_content": "### 3.3 A matrix-free higher-order power method",
            "block_bbox": [
                137,
                1118,
                797,
                1150
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
