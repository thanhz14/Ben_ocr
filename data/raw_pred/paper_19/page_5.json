                    636.0
                ],
                [
                    92.0,
                    636.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "residual; classical impedance leaves a 0.28 mm approach error against it, which the offset-free integrator drives to 0.03 mm (90% reduction)—rejecting genuine model-reduction error, not a synthetic bias.",
            "block_bbox": [
                131,
                710,
                603,
                804
            ],
            "block_id": 4,
            "block_order": 1,
            "group_id": 4,
            "block_polygon_points": [
                [
                    131.0,
