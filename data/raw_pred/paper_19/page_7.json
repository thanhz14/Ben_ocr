                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### VII. Conclusion",
            "block_bbox": [
                265,
                1253,
                434,
                1275
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    265.0,
