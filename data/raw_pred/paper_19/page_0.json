        {
            "block_label": "paragraph_title",
            "block_content": "### A. Clinical Motivation",
            "block_bbox": [
                94,
                1137,
                287,
                1158
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "block_polygon_points": [
