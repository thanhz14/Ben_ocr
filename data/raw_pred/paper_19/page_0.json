                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### C. Related Work",
            "block_bbox": [
                620,
                1134,
                766,
                1156
            ],
            "block_id": 13,
            "block_order": 11,
            "group_id": 13,
            "block_polygon_points": [
                [
