                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The canonical model library, with the protocol that uses it to enforce theory lineage, is what most distinguishes this workflow from a general research agent.",
            "block_bbox": [
                136,
                711,
                1083,
                757
            ],
            "block_id": 6,
            "block_order": 5,
