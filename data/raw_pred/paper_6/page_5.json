        {
            "block_label": "paragraph_title",
            "block_content": "## 4 The Canonical Model Library and Theory-Lineage Protocol",
            "block_bbox": [
                137,
                653,
                797,
                680
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
