            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 4.2 Two Demonstrations of Canonical Matching",
            "block_bbox": [
                139,
                1224,
                568,
                1247
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
                [
                    139.0,
