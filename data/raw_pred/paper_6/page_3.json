        {
            "block_label": "paragraph_title",
            "block_content": "### 3.1 Entry Modes and Orchestration Core",
            "block_bbox": [
                140,
                1019,
                511,
                1041
            ],
            "block_id": 6,
            "block_order": 3,
            "group_id": 6,
            "block_polygon_points": [
