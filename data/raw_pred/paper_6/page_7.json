            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 5.3 Tasks 2, 3, and 5: Detection Without Full Resolution",
            "block_bbox": [
                139,
                1095,
                636,
                1118
            ],
            "block_id": 7,
            "block_order": 4,
            "group_id": 7,
            "block_polygon_points": [
