        },
        {
            "block_label": "text",
            "block_content": "The demonstrations show that the workflow runs end to end without establishing that the checks improve reliability. The evaluation asks whether evaluators prefer the gated workflow’s final manuscripts and, when a difference appears, whether the process record identifies the stage, gate, or human decision associated with the revision path.",
            "block_bbox": [
                136,
                511,
                1087,
                580
            ],
            "block_id": 5,
            "block_order": 2,
            "group_id": 5,
            "block_polygon_points": [
