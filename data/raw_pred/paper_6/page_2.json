        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 2.1 A Taxonomy of Failure Modes",
            "block_bbox": [
                139,
                524,
                450,
                548
            ],
            "block_id": 4,
            "block_order": 1,
            "group_id": 4,
            "block_polygon_points": [
                [
                    139.0,
                    524.0
                ],
                [
                    450.0,
                    524.0
                ],
                [
                    450.0,
                    548.0
