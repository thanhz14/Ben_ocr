        {
            "block_label": "paragraph_title",
            "block_content": "### 3.4 Relation to Multi-Agent Systems",
            "block_bbox": [
                139,
                1108,
                470,
                1131
            ],
            "block_id": 9,
            "block_order": 4,
            "group_id": 9,
