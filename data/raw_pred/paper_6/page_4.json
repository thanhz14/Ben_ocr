        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 3.3 Quality Gates, Human Oversight, and the Run Workspace",
            "block_bbox": [
                139,
                772,
                688,
                796
            ],
            "block_id": 7,
            "block_order": 2,
            "group_id": 7,
            "block_polygon_points": [
