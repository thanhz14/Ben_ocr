        },
        {
            "block_label": "paragraph_title",
            "block_content": "### D.3 Task 3: Nutrition-Capital DSGE",
            "block_bbox": [
                140,
                493,
                473,
                516
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
