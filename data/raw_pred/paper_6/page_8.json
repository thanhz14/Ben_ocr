        },
        {
            "block_label": "paragraph_title",
            "block_content": "## 6 Limitations",
            "block_bbox": [
                140,
                643,
                302,
                668
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
                [
