        {
            "block_label": "paragraph_title",
            "block_content": "### 5.4 Task 4: Institutional Reframing and Proposition Repair",
            "block_bbox": [
                138,
                147,
                666,
                170
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
                [
                    138.0,
