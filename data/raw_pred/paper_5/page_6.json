        {
            "block_label": "text",
            "block_content": "Proposition 3 (Price Impact of Order Flow Innovations). In any round n,",
            "block_bbox": [
                137,
                183,
                808,
                209
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
