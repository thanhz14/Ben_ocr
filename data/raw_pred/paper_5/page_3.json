        {
            "block_label": "paragraph_title",
            "block_content": "### 2. $ A_{1} $",
            "block_bbox": [
                139,
                319,
                597,
                346
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    139.0,
