    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "requires no counterparty to knowingly bear a liquidity cost on investors' behalf. The  $ \\lambda $ dynamics further offer a resolution to the liquidity premium puzzle grounded in adverse selection rather than risk compensation.",
            "block_bbox": [
                137,
                148,
                1082,
