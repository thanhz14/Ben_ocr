                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 2.3 Price Discovery and Information Shares",
            "block_bbox": [
                139,
                1287,
                680,
                1313
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
