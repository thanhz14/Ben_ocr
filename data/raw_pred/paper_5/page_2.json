        {
            "block_label": "paragraph_title",
            "block_content": "## 2 Related Literature",
            "block_bbox": [
                139,
                255,
                458,
                284
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
