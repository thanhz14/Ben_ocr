                    163.0,
                    1318.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• We construct all variables from CRSP daily and monthly equity data.",
            "block_bbox": [
                211,
                1333,
                850,
                1358
            ],
            "block_id": 16,
            "block_order": 17,
            "group_id": 16,
            "block_polygon_points": [
