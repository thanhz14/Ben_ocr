                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### 7. Data and Frequency Conventions",
            "block_bbox": [
                163,
                1294,
                531,
                1318
            ],
            "block_id": 15,
            "block_order": 16,
            "group_id": 15,
            "block_polygon_points": [
