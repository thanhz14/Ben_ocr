        {
            "block_label": "text",
            "block_content": "existence has been studied directly by Bagnoli et al. (2001); Back and Baruch (2004) further show that this linear, continuous-time equilibrium arises as the limit of a sequential trade-by-trade equilibrium in the spirit of Glosten and Milgrom (1985).",
            "block_bbox": [
                231,
                146,
                1083,
                220
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
