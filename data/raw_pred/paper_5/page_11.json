        {
            "block_label": "paragraph_title",
            "block_content": "### 8. Rolling Estimation and Predictive Regressions",
            "block_bbox": [
                162,
                258,
                665,
                282
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    169.0,
