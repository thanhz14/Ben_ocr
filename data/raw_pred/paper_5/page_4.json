                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "We assume three types of market participants: Short-horizon traders who rebalance monthly and long-horizon buy-and-hold investors. Among both long- and short-term investors, a fixed proportion  $ \\alpha $ is informed.",
            "block_bbox": [
                138,
                1282,
                1081,
                1328
            ],
            "block_id": 15,
            "block_order": 16,
            "group_id": 15,
            "block_polygon_points": [
                [
