        {
            "block_label": "paragraph_title",
            "block_content": "## Abstract",
            "block_bbox": [
                569,
                401,
                655,
                421
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
