        {
            "block_label": "text",
            "block_content": "Phuc H. Nguyen $ ^{*} $, Ba Hung Ngo $ ^{*} $, Mai Phuong Tran, Cuong D. Do and Van-Dinh Nguyen",
            "block_bbox": [
