        {
            "block_label": "paragraph_title",
            "block_content": "### J. Model Complexity Analysis",
            "block_bbox": [
                619,
                480,
                875,
                502
            ],
            "block_id": 11,
            "block_order": 6,
            "group_id": 11,
            "block_polygon_points": [
                [
                    619.0,
