        {
            "block_label": "figure_title",
            "block_content": "<div style=\"text-align: center;\">Fig. 10. Prototype correlation matrix ( $ \\lambda_{ortho} = 0.5 $). The heatmap shows the cosine similarity between learned prototype vectors.</div>\n",
            "block_bbox": [
                92,
                543,
                603,
                581
            ],
            "block_id": 3,
            "block_order": null,
