            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "### VI. Conclusion",
            "block_bbox": [
                795,
                786,
                956,
                807
            ],
            "block_id": 13,
            "block_order": 8,
            "group_id": 13,
            "block_polygon_points": [
