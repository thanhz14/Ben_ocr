        },
        {
            "block_label": "text",
            "block_content": "presented in Fig. 9 for analyzing different traits under varying orthogonality weights ( $ \\lambda_{ortho} $).",
            "block_bbox": [
                91,
                625,
                603,
                673
            ],
            "block_id": 4,
            "block_order": 1,
            "group_id": 4,
            "block_polygon_points": [
                [
