                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "and ultra-rare species classification (dashed pink line with ▲ marker).",
            "block_bbox": [
                617,
                532,
                1128,
                578
            ],
            "block_id": 12,
            "block_order": 7,
            "group_id": 12,
            "block_polygon_points": [
                [
                    617.0,
