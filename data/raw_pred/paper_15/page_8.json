        },
        {
            "block_label": "figure_title",
            "block_content": "<div style=\"text-align: center;\">Fig. 5. Gradient Alignment in Shared Backbone. Cosine similarity between classification and segmentation gradients: the baseline (black, dark red) shows frequent conflicts (negative values), while FISHER (yellow) maintains stable positive alignment.</div>\n",
            "block_bbox": [
                616,
                415,
                1129,
                491
            ],
            "block_id": 11,
            "block_order": null,
            "group_id": 11,
            "block_polygon_points": [
