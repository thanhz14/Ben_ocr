        {
            "block_label": "paragraph_title",
            "block_content": "### F. Gradient Alignment Analysis",
            "block_bbox": [
                92,
                1176,
                362,
                1199
            ],
            "block_id": 10,
            "block_order": 2,
            "group_id": 10,
