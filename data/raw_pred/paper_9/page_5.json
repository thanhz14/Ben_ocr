                [
                    372.0,
                    584.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "is defined already. Hence, the valency of each vertex in  $ V_{1} $ is  $ n - k + 1 $, and the valency for each vertex in  $ V_{2} $ is k. Then",
            "block_bbox": [
                159,
                593,
                1021,
                651
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    159.0,
                    593.0
                ],
                [
                    1021.0,
                    593.0
                ],
                [
                    1021.0,
                    651.0
                ],
                [
                    159.0,
                    651.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ |V(B L_{n}(k-1,k))|=\\binom{n+1}{k},\\quad|E(B L_{n}(k-1,k))|=k\\binom{n}{k}. $$ ",
            "block_bbox": [
                264,
                668,
                913,
                733
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    264.0,
