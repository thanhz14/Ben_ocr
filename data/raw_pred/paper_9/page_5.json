        {
            "block_label": "text",
            "block_content": "•  $ \\mu_j = \\pm \\sqrt{(k-j)(n-k+1-j)} $, for  $ j = 0, 1, 2, \\ldots, k-1 $, with multiplicities  $ m(\\mu_j) $,",
            "block_bbox": [
