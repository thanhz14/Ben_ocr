                    264.0,
                    733.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Now, let $B$ be the incidence matrix of the graph $G$, $\\Delta(G)$ be the diagonal degree matrix of graph $G$, and $A(G)$ be the adjacency matrix of graph $G$. Since $G$ is bipartite, then",
            "block_bbox": [
                160,
                752,
                1020,
                840
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    160.0,
                    752.0
                ],
                [
                    1020.0,
                    752.0
                ],
                [
                    1020.0,
                    840.0
                ],
                [
                    160.0,
                    840.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ A(G)=\\begin{pmatrix}{{{0}}}&{{{N}}} \\\\{{{N^{T}}}}&{{{0}}}\\end{pmatrix}, $$ ",
            "block_bbox": [
                482,
                836,
                698,
                897
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    482.0,
                    836.0
                ],
                [
                    698.0,
                    836.0
                ],
                [
                    698.0,
                    897.0
                ],
                [
                    482.0,
                    897.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "where  $ N $ is the  $ \\binom{n}{k-1} \\times \\binom{n}{k} $ bipartite incidence matrix so that rows correspond to vertices in the first part  $ k - 1 $-subsets of  $ G $, and columns correspond to vertices in the second part  $ k $-subsets of  $ G $. Since  $ rank(N) = rank(N^T) $, then  $ rank(A(G)) = 2rank(N) $. Also, after ordering vertices of  $ G $ so that the  $ (k - 1) $-subsets come first and the  $ k $-subsets second, we have",
            "block_bbox": [
                160,
                909,
                1021,
                1053
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
