                ],
                [
                    340.0,
                    492.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "and",
            "block_bbox": [
                161,
                505,
                209,
                530
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    160.99998474121094,
                    505.0
                ],
                [
                    207.99998474121094,
                    505.0
                ],
                [
                    207.99998474121094,
                    529.0
                ],
                [
                    160.99998474121094,
                    529.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ V_{2}=\\{W\\subset[n]\\mid|W|=k\\},\\quad|V_{2}|=\\binom{n}{k}, $$ ",
            "block_bbox": [
                372,
                526,
                806,
                584
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
