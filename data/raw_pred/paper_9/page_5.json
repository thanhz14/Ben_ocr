                    1053.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\Delta(B L_{n}(k-1,k))=\\begin{pmatrix}{{{(n-k+1)I_{\\binom{n}{k-1}}}}}&{{{0}}} \\\\{{{0}}}&{{{k I_{\\binom{n}{k}}}}} \\\\\\end{pmatrix}. $$ ",
            "block_bbox": [
