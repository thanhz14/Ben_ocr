        {
            "block_label": "paragraph_title",
            "block_content": "## Notation and adjacency spectra",
            "block_bbox": [
                161,
                1044,
                619,
                1076
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
