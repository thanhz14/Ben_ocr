        },
        {
            "block_label": "paragraph_title",
            "block_content": "## Contribution of this paper",
            "block_bbox": [
                162,
                524,
                543,
                556
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
