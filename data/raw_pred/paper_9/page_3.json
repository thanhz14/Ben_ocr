                ],
                [
                    161.0,
                    1266.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\mathrm{S p e c}(\\Gamma)=\\left\\{\\lambda_{1}^{m_{1}},\\lambda_{2}^{m_{2}},\\ldots,\\lambda_{r}^{m_{r}}\\right\\}. $$ ",
