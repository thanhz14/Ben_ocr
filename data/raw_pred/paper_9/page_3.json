            ]
        },
        {
            "block_label": "text",
            "block_content": "The adjacency matrix  $ A(\\Gamma) $ of a graph  $ \\Gamma $ is the symmetric  $ \\{0,1\\} $-matrix whose rows and columns are indexed by  $ V(\\Gamma) $, with the  $ (i,j) $-entry equal to 1 if  $ \\{i,j\\} \\in E(\\Gamma) $ and 0 otherwise. The eigenvalues of  $ \\Gamma $ are the roots of the characteristic polynomial  $ \\det(xI_n - A(\\Gamma)) $. The spectrum of  $ \\Gamma $ is the multiset of eigenvalues of  $ A(\\Gamma) $. When the distinct eigenvalues are  $ \\lambda_1 > \\lambda_2 > \\cdots > \\lambda_r $ with respective multiplicities  $ m_1, m_2, \\ldots, m_r $, we write",
            "block_bbox": [
                161,
                1091,
                1020,
                1266
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
