            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "## Integral graphs",
            "block_bbox": [
                161,
                771,
                386,
                804
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    161.0,
