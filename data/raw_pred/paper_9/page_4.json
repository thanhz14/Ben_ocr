                    160.0,
                    869.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Theorem 2.3 ([4]) The Johnson graph  $ J(n, k-1) $ has eigenvalues",
            "block_bbox": [
                161,
                891,
                880,
                921
            ],
            "block_id": 7,
