                [
                    198.0,
                    888.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "● As a special case (Example 3.3), we completed the result of Mirafzal [13] by computing the multiplicities of all eigenvalues of the line graph  $ L(n) = L(BL_{n}(1,2)) $, which were left undetermined in [13].",
            "block_bbox": [
                197,
                906,
                1019,
                995
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
