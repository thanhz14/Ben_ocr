        },
        {
            "block_label": "text",
            "block_content": "We evaluate the relaxation time  $ \\tau $, which governs the speed of this genetic assimilation. Substituting Eq. (19) and Eq. (20) into Eq. (14), we obtain:",
            "block_bbox": [
                101,
                298,
                600,
                370
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
