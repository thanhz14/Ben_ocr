                [
                    101.0,
                    370.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\tau=-\\frac{F_{xx}}{G_{yy}\\det H}=\\frac{s+c}{G_{yy}sc}=\\frac{1}{G_{yy}}\\left(\\frac{1}{s}+\\frac{1}{c}\\right) $$ ",
