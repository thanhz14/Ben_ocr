        {
            "block_label": "image",
            "block_content": "<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_117_113_1116_886.jpg\" alt=\"Image\" width=\"81%\" />\n\nA Adapted state\nB Environmental shift\nC Fast plastic relaxation\nD Slow genetic relaxation\nPhenotype x\nGenotype y\nPhenotypic slice\nPhenotype x\nGenetic slice\nGenotype y\n\n</div>\n",
            "block_bbox": [
