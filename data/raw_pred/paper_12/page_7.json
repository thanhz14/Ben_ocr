                [
                    1127.0,
                    1282.0
                ],
                [
                    1127.0,
                    1331.0
                ],
                [
                    101.0,
                    1331.0
                ]
            ]
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\mathcal{D}_{i j}f(t)=[1-\\dot{d}_{i j}(t)]f[t-d_{i j}(t)], $$ ",
