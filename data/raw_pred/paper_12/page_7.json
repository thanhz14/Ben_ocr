        {
            "block_label": "text",
            "block_content": "TDI is a process that cancel the significant laser phase noise and forming a virtual laser interference signal. Delay operator  $ D_{ij} $ is defined as",
            "block_bbox": [
                101,
                1282,
                1127,
                1331
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "block_polygon_points": [
                [
                    101.0,
                    1282.0
