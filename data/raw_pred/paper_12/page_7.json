        {
            "block_label": "figure_title",
            "block_content": "<div style=\"text-align: center;\">FIG. 4. Posterior distributions for ACC and OMS noise amplitudes in 2.8_EQ datasets, arranged in ascending order of SC index i from top to bottom. The red lines denote injected values while the vertical dashed lines show the median and 1σ CI.</div>\n",
            "block_bbox": [
