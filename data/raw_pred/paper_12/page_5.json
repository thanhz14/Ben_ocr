        {
            "block_label": "paragraph_title",
            "block_content": "### IV. RESULTS",
            "block_bbox": [
                538,
                939,
                693,
                960
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    538.0,
