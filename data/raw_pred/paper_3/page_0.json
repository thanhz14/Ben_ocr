                    864.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "## 2 Related Work",
            "block_bbox": [
                608,
                884,
                795,
                910
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    608.0,
                    884.0
                ],
                [
                    795.0,
                    884.0
                ],
                [
                    795.0,
                    910.0
                ],
                [
                    608.0,
                    910.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Data Attribution methods for LLMs fall into one of three families, distinguished by the space in which they perform attribution.",
            "block_bbox": [
                606,
                926,
                1054,
                1010
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    606.0,
                    926.0
                ],
                [
                    1054.0,
                    926.0
                ],
                [
                    1054.0,
                    1010.0
                ],
                [
                    606.0,
                    1010.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Representation-based Representation-based methods function in training-agnostic feature spaces, meaning they tend to work out-of-the-box and are generally cheap to compute. Examples include TF-IDF, (Ni et al., 2022) for semantic similarity, and RDS+ (Ivison et al., 2025), which uses the model's activation space.",
            "block_bbox": [
                604,
                1023,
                1054,
                1214
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    604.0,
                    1023.0
                ],
                [
                    1054.0,
                    1023.0
                ],
                [
                    1054.0,
                    1214.0
                ],
                [
                    604.0,
                    1214.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Projection-based influence methods Early approaches at scaling influence functions for LLMs (Grosse et al., 2023) operated on fully dense gradients, but storage constraints pushed subsequent methods towards projection based approaches. TRAK (Park et al., 2023) randomly projects the gradients, which conserves the expected dot product value (Johnson and Lindenstrauss, 1984). On the other hand, TrackSTAR (Chang et al., 2025) and LoGRA (Choe et al., 2026) use two-sided auxiliary projections which are added on top of linear layers to calculate influence with a low memory",
            "block_bbox": [
                604,
                1229,
                1058,
                1556
            ],
            "block_id": 13,
            "block_order": 13,
