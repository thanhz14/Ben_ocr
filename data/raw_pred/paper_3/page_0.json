                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Contribution In this paper we put forth a novel method for influence estimation through distilling gradient influence rankings into an encoder model. Due to the high processing speeds of encoders, our method demonstrates a path forwards towards effective data attribution at large data scales.",
            "block_bbox": [
                606,
                702,
                1055,
                864
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    606.0,
                    702.0
                ],
                [
                    1055.0,
                    702.0
                ],
                [
                    1055.0,
                    864.0
                ],
                [
