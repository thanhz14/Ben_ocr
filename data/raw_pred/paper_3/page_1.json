                [
                    134.0,
                    1155.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "AirRep (Sun et al., 2025), which shares a similar approach to us, distills true training losses into an encoder. We remain fundamentally different since we distill gradient influences. And additionally it has a different architecture that treats samples interdependently to optimize for SFT. Conversely, we treat samples independently.",
            "block_bbox": [
                134,
                1157,
                583,
                1347
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
