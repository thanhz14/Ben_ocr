# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and packaging artifacts
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Test, type-checking, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables and local settings
.env
.env.*
!.env.example

# Editors and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Windows alternate data streams copied to non-NTFS filesystems
*:Zone.Identifier
tmp